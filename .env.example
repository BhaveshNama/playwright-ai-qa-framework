# ============================================================
# AgenticQA Nexus - Example Environment Configuration
# ============================================================
#
# Copy this file to .env for local development.
# Never commit real passwords, tokens, keys, or client data.

# ------------------------------------------------------------
# Execution
# ------------------------------------------------------------

# Supported values: local, dev, qa
TEST_ENV=local

# Controls application/runtime logging.
# Supported values: debug, info, warn, error
LOG_LEVEL=info

# ------------------------------------------------------------
# Web application
# ------------------------------------------------------------

# Target UI application.
#BASE_URL=https://playwright.dev
BASE_URL=http://127.0.0.1:3000
# ------------------------------------------------------------
# API testing
# ------------------------------------------------------------

# Target API used by API-level tests.
#API_BASE_URL=https://jsonplaceholder.typicode.com
API_BASE_URL=http://127.0.0.1:3000

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Populate only in the local .env when authentication is introduced.
AUTOMATION_USERNAME=
AUTOMATION_PASSWORD=

# ------------------------------------------------------------
# AI
# ------------------------------------------------------------

# AI functionality is not enabled yet.
AI_PROVIDER=disabled

# Never place a real key in .env.example.
AI_API_KEY=

# ------------------------------------------------------------
# NexusShop local application
# ------------------------------------------------------------

NEXUS_SHOP_HOST=127.0.0.1
NEXUS_SHOP_PORT=3000