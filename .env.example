# ============================================================
# AgenticQA Nexus - Example Environment Configuration
# ============================================================
#
# Copy this file to .env for local development.
# Never place real passwords, tokens, or API keys in this file.

# Target application
BASE_URL=

# API under test
API_BASE_URL=

# Synthetic non-production automation credentials
AUTOMATION_USERNAME=
AUTOMATION_PASSWORD=

# Execution environment
TEST_ENV=local

# Runtime logging
LOG_LEVEL=info

# AI configuration will be introduced in a later milestone.
AI_PROVIDER=
AI_API_KEY=
