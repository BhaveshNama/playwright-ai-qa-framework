{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["node", "@playwright/test"]
  },

  "include": ["automation/**/*.ts", "scripts/**/*.ts", "playwright.config.ts"],

  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results",
    "allure-results",
    "allure-report",
    "artifacts"
  ]
}
